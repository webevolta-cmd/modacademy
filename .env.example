# Copy to .env for local builds. None of these are secrets.

# Absolute public URL of the deployment. Netlify provides URL automatically.
SITE_URL=https://modacademy.netlify.app

# Set to "true" only for the real production site. Netlify production builds default to true.
SITE_INDEXABLE=false

# Optional: send inquiries to an external form endpoint instead of Netlify Forms.
# FORM_ENDPOINT=https://formspree.io/f/xxxxxxx
