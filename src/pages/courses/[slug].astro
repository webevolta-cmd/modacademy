---
import { Picture, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SplitText from '../../components/SplitText.astro';
import CourseArt from '../../components/CourseArt.astro';
import Icon from '../../components/Icon.astro';
import InquiryForm from '../../components/InquiryForm.astro';
import Faq from '../../components/Faq.astro';
import Lightbox from '../../components/Lightbox.astro';
import Upper from '../../components/Upper.astro';
import { keep } from '../../lib/text';
import { courses, formatFee, priceNote, type Course } from '../../data/courses';
import { faq } from '../../data/faq';
import { work, practice, student, extraImages } from '../../data/media';
import { site } from '../../data/site';

export function getStaticPaths() {
  return courses.map((course) => ({ params: { slug: course.slug }, props: { course } }));
}

interface Props {
  course: Course;
}
const { course } = Astro.props;
const siteUrl = Astro.site!;
const others = courses.filter((c) => c.slug !== course.slug);

const faqIds =
  course.category === 'visual'
    ? ['experience', 'laptop', 'fees', 'certificate', 'apply']
    : course.slug === 'interior-design'
      ? ['practice', 'fees', 'certificate', 'format', 'apply']
      : ['experience', 'fees', 'certificate', 'format', 'apply'];
const courseFaq = faqIds.map((id) => faq.find((f) => f.id === id)!).filter(Boolean);

type Media = { image: ImageMetadata; alt: string; title: string; credit: string };
let gallery: Media[] = [];
// Work from another course is labelled as such (e.g. the Corona course has no published work yet).
const ownWork = course.slug === student.courseSlug;
if (course.related === 'work') {
  gallery = work.slice(0, 4).map((w) => ({ image: w.image, alt: w.alt, title: w.title, credit: `${student.name} · ${student.role}` }));
} else if (course.related === 'practice') {
  gallery = practice
    .filter((p) => p.partner !== site.name)
    .slice(0, 4)
    .map((p) => ({ image: p.image, alt: p.alt, title: p.caption, credit: p.partner }));
} else if (course.related === 'sales') {
  gallery = [
    { image: practice[5].image, alt: practice[5].alt, title: practice[5].caption, credit: '«Վաճառքի կառավարում» դասընթաց' },
    { image: extraImages.salesTrainer, alt: 'Վաճառքի կառավարման դասը վարողը բացատրում է նյութը մասնակիցներին', title: 'Ինտերակտիվ դաս', credit: '«Վաճառքի կառավարում» դասընթաց' },
  ];
}

const galleryItems = await Promise.all(
  gallery.map(async (g) => ({ ...g, large: (await getImage({ src: g.image, width: 1600, format: 'webp', quality: 85 })).src })),
);

// Social previews need a full 1200×630 crop; smaller masters fall back to the brand card.
const ogFromCourse = course.image && course.image.width >= 1200 && course.image.height >= 630;
const ogImage = ogFromCourse
  ? (await getImage({ src: course.image!, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 })).src
  : undefined;

const months = Number(course.duration?.match(/^(\d+)\s*ամիս/)?.[1] ?? 0);
const monthly = course.fee?.unit === 'ամսական';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Course',
    name: course.title,
    description: course.summary,
    url: new URL(`/courses/${course.slug}/`, siteUrl).href,
    inLanguage: 'hy',
    ...(months ? { timeRequired: `P${months}M` } : {}),
    ...(course.fee
      ? {
          offers: {
            '@type': 'Offer',
            category: 'Paid',
            // A monthly fee is multiplied out for the whole course; the monthly amount stays in the breakdown.
            price: monthly && months ? course.fee.amount * months : course.fee.amount,
            priceCurrency: 'AMD',
            priceSpecification: {
              '@type': 'UnitPriceSpecification',
              price: course.fee.amount,
              priceCurrency: 'AMD',
              ...(monthly ? { billingDuration: 'P1M', unitText: 'MONTH' } : {}),
            },
          },
        }
      : {}),
    provider: {
      '@type': 'EducationalOrganization',
      '@id': new URL('/#organization', siteUrl).href,
      name: site.name,
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Գլխավոր', item: new URL('/', siteUrl).href },
      { '@type': 'ListItem', position: 2, name: 'Դասընթացներ', item: new URL('/courses/', siteUrl).href },
      { '@type': 'ListItem', position: 3, name: course.title, item: new URL(`/courses/${course.slug}/`, siteUrl).href },
    ],
  },
];

const ask = 'Ճշտեք ընթացիկ տվյալները';
const sheet = [
  { k: 'Տևողություն', v: course.duration },
  { k: 'Ժամանակացույց', v: course.schedule ? 'schedule' : null },
  { k: 'Արժեք', v: course.fee ? 'fee' : null },
  { k: 'Ձևաչափ', v: course.format },
  { k: 'Մակարդակ', v: course.level },
  { k: 'Մեկնարկ', v: course.start },
];


const description =
  course.summary.length > 110 ? course.summary : `${course.summary} MOD Academy, ${site.address.city}, ${site.address.short}։`;
---
<BaseLayout
  title={`${course.title} — դասընթաց | MOD Academy, Երևան`}
  description={description}
  image={ogImage}
  imageAlt={ogFromCourse ? course.imageAlt : undefined}
  jsonLd={jsonLd}
  headerCta="#inquiry"
>
  <article class="cp" aria-labelledby="cp-title">
    <header class="cp__hero">
      <div class="wrap cp__hero-grid">
        <div class="cp__intro">
          <nav aria-label="Ճանապարհ" class="cp__crumbs">
            <ol role="list">
              <li><a href="/">Գլխավոր</a></li>
              <li><a href="/courses/">Դասընթացներ</a></li>
              <li aria-current="page">{course.title}</li>
            </ol>
          </nav>
          <p class="label label--red" data-reveal>{course.kicker}</p>
          <SplitText as="h1" id="cp-title" class="display cp__title" text={course.title} />
          <p class="lead" data-reveal>{keep(course.summary)}</p>
          <div class="cp__ctas" data-reveal>
            <a class="btn btn--red" href="#inquiry">
              {course.fee ? 'Ուղարկել հայտ' : 'Ստանալ ընթացիկ մանրամասներ'}<Icon name="arrow" class="btn__icon" />
            </a>
            <a class="btn btn--ghost" href={site.phone.href}><Icon name="phone" class="btn__icon" />{site.phone.local}</a>
          </div>
        </div>

        <figure class="cp__visual">
          <div class="frame cp__frame">
            {course.image ? (
              <Picture
                src={course.image}
                alt={course.imageAlt}
                widths={[480, 720, 1080, 1440]}
                sizes="(min-width: 1000px) 46vw, 92vw"
                formats={['avif', 'webp']}
                fallbackFormat="webp"
                loading="eager"
                fetchpriority="high"
                data-parallax
                style="--ps:1.1"
              />
            ) : (
              <CourseArt letter={course.title.charAt(0)} />
            )}
            <span class="ticks" aria-hidden="true"></span>
          </div>
          {course.imageCredit && <figcaption class="credit">{keep(course.imageCredit)}</figcaption>}
        </figure>
      </div>
    </header>

    <section class="cp__sheet-wrap" aria-label="Դասընթացի հիմնական տվյալներ">
      <div class="wrap">
        <dl class="sheet" data-reveal>
          {sheet.map((row) => (
            <div class="sheet__cell">
              <dt><Upper text={row.k} /></dt>
              <dd class:list={{ 'is-ask': !row.v }}>
                {row.v === 'schedule' && course.schedule
                  ? (
                      <span class="sheet__grp">
                        <span>{course.schedule.frequency}</span>
                        <span class="sheet__time">{keep(course.schedule.length)}</span>
                      </span>
                    )
                  : row.v === 'fee' && course.fee
                    ? (
                        <>
                          <span class="sheet__grp">{formatFee(course.fee.amount)}</span>
                          <span class="sheet__unit">{course.fee.unit}</span>
                        </>
                      )
                    : (row.v ?? ask)}
              </dd>
            </div>
          ))}
          <div class="sheet__brand" aria-hidden="true">
            <span>MOD ACADEMY</span>
            <span class="num">{site.address.short}</span>
          </div>
        </dl>
        <p class="cp__note muted">{course.fee || course.schedule ? priceNote : 'Այս դասընթացի տևողության, ժամանակացույցի և արժեքի թարմ տվյալները կներկայացնենք Ձեր հայտից հետո։'}</p>
      </div>
    </section>

    <section class="cp__body section--tight">
      <div class="wrap cp__cols">
        <div class="cp__main">
          <h2 class="h2" data-reveal>Դասընթացի մասին</h2>
          {course.intro.map((p) => <p class="cp__p" data-reveal>{keep(p)}</p>)}

          {course.focus.length > 0 && (
            <>
              <h2 class="h2 cp__h" data-reveal>{course.slug === 'interior-design' ? 'Գործնական դասեր' : 'Ինչ է ներառում'}</h2>
              <ol class="cp__focus" role="list">
                {course.focus.map((f, i) => (
                  <li data-reveal style={`--i:${i}`}>
                    <span class="num cp__fi">{String(i + 1).padStart(2, '0')}</span>
                    <h3 class="h3">{f.title}</h3>
                    <p class="muted">{keep(f.text)}</p>
                  </li>
                ))}
              </ol>
            </>
          )}
        </div>

        <aside class="cp__side">
          <div class="cp__box" data-reveal>
            <h2 class="label">Ում համար է</h2>
            <ul class="cp__aud">
              {course.audience.map((a) => (
                <li><Icon name="check" class="cp__tick" />{a}</li>
              ))}
            </ul>
          </div>
          {course.tools.length > 0 && (
            <div class="cp__box" data-reveal>
              <h2 class="label">Ծրագրեր</h2>
              <ul class="cp__tools" role="list">
                {course.tools.map((t) => <li class="tag">{t}</li>)}
              </ul>
            </div>
          )}
        </aside>
      </div>
    </section>

    {galleryItems.length > 0 && (
      <section class="cp__gallery section--tight" aria-labelledby="cp-gallery-title">
        <div class="wrap">
          <h2 class="h2" id="cp-gallery-title" data-reveal>
            {course.related === 'work'
              ? ownWork
                ? 'Ուսանողական աշխատանքներ'
                : `Մեր ուսանողների աշխատանքները («${student.course.replace(' ', '\u00a0')}» դասընթաց)`
              : course.related === 'practice'
                ? 'Գործնական դասերից'
                : 'Դասերից'}
          </h2>
          {course.related === 'work' && !ownWork && (
            <p class="muted cp__gnote" data-reveal>«{course.title}» դասընթացի աշխատանքներ դեռ չեն հրապարակվել։</p>
          )}
          <ul class="cp__grid" role="list">
            {galleryItems.map((g, i) => (
              <li data-reveal style={`--i:${i}`}>
                <button
                  type="button"
                  class="cp__thumb frame"
                  data-lb-group="course"
                  data-lb-src={g.large}
                  data-lb-alt={g.alt}
                  data-lb-title={g.title}
                  data-lb-credit={g.credit}
                  aria-label={`Բացել մեծ չափով՝ ${g.title}`}
                >
                  <Picture src={g.image} alt={g.alt} widths={[360, 540, 800]} sizes="(min-width: 900px) 24vw, 46vw" formats={['avif', 'webp']}
                fallbackFormat="webp"
                loading="lazy" />
                </button>
                <p class="credit">{keep(`${g.title} · ${g.credit}`)}</p>
              </li>
            ))}
          </ul>
          {course.related === 'work' && (
            <a class="link-arrow cp__more" href="/student-work/">Բոլոր աշխատանքները<Icon name="arrow" /></a>
          )}
        </div>
      </section>
    )}

    <Faq items={courseFaq} n="—" title="Հարցեր այս դասընթացի մասին" />

    <section class="cp__form section" id="inquiry" aria-label="Հայտ">
      <div class="wrap cp__form-grid">
        <div class="cp__form-intro">
          <p class="label label--red">Հայտ · {course.title}</p>
          <h2 class="h1">Ստացեք ընթացիկ մանրամասները</h2>
          <p class="lead">Մենք կկապվենք Ձեզ հետ՝ խմբերի, ժամանակացույցի և արժեքի թարմ տվյալներով։</p>
          <a class="link-arrow" href={site.phone.href}><Icon name="phone" />{site.phone.display}</a>
        </div>
        <InquiryForm preselect={course.slug} heading={`Հայտ «${course.title}» դասընթացին`} />
      </div>
    </section>

    <nav class="cp__others section--tight" aria-labelledby="cp-others-title">
      <div class="wrap">
        <h2 class="h2" id="cp-others-title">Այլ դասընթացներ</h2>
        <ul class="cp__olist" role="list">
          {others.map((c) => (
            <li>
              <a href={`/courses/${c.slug}/`}>
                <span class="label">{c.kicker}</span>
                <span class="cp__oname">{c.title}</span>
                <Icon name="arrow" class="cp__oarrow" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </nav>
  </article>
  <Lightbox />
</BaseLayout>

<style>
  .cp__hero { padding-top: calc(var(--header-h) + clamp(24px, 4vw, 56px)); padding-bottom: clamp(32px, 4vw, 56px); }
  .cp__hero-grid { display: grid; gap: 32px; }
  .cp__intro { display: grid; gap: 20px; align-content: center; }
  .cp__title { font-size: clamp(2.6rem, 1.2rem + 5vw, 6.2rem); }

  .cp__crumbs ol { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px; font-size: 0.82rem; color: var(--muted); }
  .cp__crumbs li + li::before { content: '/'; content: '/' / ''; margin-right: 6px; opacity: 0.6; }
  .cp__crumbs a { display: inline-block; padding-block: 10px; text-decoration: none; }
  .cp__crumbs a:hover { color: var(--red); }

  .cp__ctas { display: flex; flex-wrap: wrap; gap: 10px; }

  .cp__frame { position: relative; aspect-ratio: 4 / 5; overflow: hidden; }
  .cp__frame :global(img) { width: 100%; height: 100%; object-fit: cover; }

  /* Title block — modelled on an architectural drawing's title block */
  .sheet {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border: 1px solid var(--ink);
    background: var(--card);
  }

  .sheet__cell { padding: 14px 16px; border-right: 1px solid var(--line-strong); border-bottom: 1px solid var(--line-strong); display: grid; gap: 6px; align-content: start; }

  .sheet dt { font-size: 0.68rem; font-weight: 600; font-stretch: 87.5%; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .sheet dd { margin: 0; font-weight: 540; line-height: 1.45; }
  .sheet__grp { display: block; }
  .sheet__grp + .sheet__grp { margin-top: 8px; }
  .sheet__time { display: block; color: var(--muted); font-variant-numeric: tabular-nums; }
  .sheet__unit { display: block; color: var(--muted); font-weight: 400; font-size: 0.88rem; }
  .sheet dd.is-ask { color: var(--muted); font-weight: 400; font-size: 0.92rem; }

  .sheet__brand {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 16px;
    background: var(--ink);
    color: var(--paper);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
  }

  .cp__note { margin-top: 14px; font-size: 0.85rem; max-width: 52rem; }

  .cp__cols { display: grid; gap: 48px; }
  .cp__main { display: grid; gap: 18px; align-content: start; max-width: 46rem; }
  .cp__p { font-size: var(--fs-lead); line-height: 1.6; color: var(--ink-soft); }
  .cp__h { margin-top: 32px; }

  .cp__focus { display: grid; gap: 0; border-top: 1px solid var(--line-strong); }
  .cp__focus li { display: grid; grid-template-columns: 48px 1fr; column-gap: 12px; row-gap: 4px; padding-block: 18px; border-bottom: 1px solid var(--line); }
  .cp__focus .cp__fi { grid-row: 1 / span 2; color: var(--red); padding-top: 3px; }

  .cp__side { display: grid; gap: 16px; align-content: start; }
  .cp__box { padding: 20px; border: 1px solid var(--line-strong); background: var(--card); display: grid; gap: 14px; }
  .cp__aud { margin: 0; padding: 0; list-style: none; display: grid; gap: 12px; }
  .cp__aud li { display: grid; grid-template-columns: 22px 1fr; gap: 10px; line-height: 1.5; }
  .cp__aud :global(.cp__tick) { width: 20px; height: 20px; color: var(--red); margin-top: 2px; }
  .cp__tools { display: flex; flex-wrap: wrap; gap: 8px; }
  .cp__src { display: grid; gap: 10px; font-size: 0.88rem; }
  .cp__src li { display: grid; gap: 2px; }
  .cp__src a { display: inline-flex; align-items: center; gap: 6px; text-decoration: none; }
  .cp__src a:hover { color: var(--red); }
  .cp__src :global(svg) { width: 14px; height: 14px; flex: none; }
  .cp__src time { font-size: 0.78rem; }

  .cp__gallery { background: var(--paper-2); }
  .cp__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin-top: 28px; }
  .cp__thumb { display: block; width: 100%; aspect-ratio: 4 / 5; padding: 0; border: 0; cursor: zoom-in; }
  .cp__thumb :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.1s var(--ease-out); }
  .cp__thumb:hover :global(img) { transform: scale(1.05); }
  .cp__more { margin-top: 24px; }
  .cp__gnote { margin-top: 10px; font-size: 0.9rem; }

  .cp__form-grid { display: grid; gap: 40px; }
  .cp__form-intro { display: grid; gap: 18px; align-content: start; }

  .cp__others { border-top: 1px solid var(--line-strong); }
  .cp__olist { display: grid; margin-top: 24px; border-top: 1px solid var(--line-strong); }
  .cp__olist a {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2px 16px;
    padding-block: 18px;
    border-bottom: 1px solid var(--line-strong);
    text-decoration: none;
    transition: padding 0.5s var(--ease-out), color 0.3s;
  }

  .cp__olist .label { grid-column: 1; color: var(--muted); }
  .cp__oname { grid-column: 1; font-family: var(--font-display); font-stretch: 87.5%; font-size: var(--fs-h2); line-height: 1.15; }
  .cp__olist :global(.cp__oarrow) { grid-column: 2; grid-row: 1 / span 2; align-self: center; width: 28px; height: 28px; transition: transform 0.5s var(--ease-out); }
  .cp__olist a:hover { color: var(--red); padding-left: 12px; }
  .cp__olist a:hover :global(.cp__oarrow) { transform: translateX(6px); }

  @media (min-width: 700px) {
    .sheet { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (min-width: 1000px) {
    .cp__hero-grid { grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); align-items: center; gap: clamp(32px, 5vw, 96px); }
    .sheet { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .cp__cols { grid-template-columns: minmax(0, 1.4fr) minmax(300px, 0.8fr); gap: clamp(40px, 6vw, 96px); }
    .cp__side { position: sticky; top: calc(var(--header-h) + 24px); align-self: start; }
    .cp__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .cp__form-grid { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); align-items: start; }
    .cp__form-intro { position: sticky; top: calc(var(--header-h) + 40px); align-self: start; }
  }
</style>
