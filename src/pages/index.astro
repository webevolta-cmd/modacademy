---
import BaseLayout from '../layouts/BaseLayout.astro';
import JourneyHero from '../components/JourneyHero.astro';
import { filmSegments } from '../data/hero';
import About from '../components/About.astro';
import Courses from '../components/Courses.astro';
import Finder from '../components/Finder.astro';
import Learning from '../components/Learning.astro';
import GraduatesFeature from '../components/GraduatesFeature.astro';
import WorkTeaser from '../components/WorkTeaser.astro';
import VideosTeaser from '../components/VideosTeaser.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Contact from '../components/Contact.astro';
import Lightbox from '../components/Lightbox.astro';
import { site } from '../data/site';
import { courses } from '../data/courses';
import { faq } from '../data/faq';

const siteUrl = Astro.site!;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'MOD Academy դասընթացներ',
    // Summary list: full Course markup lives on each course page.
    itemListElement: courses.map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(`/courses/${c.slug}/`, siteUrl).href,
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: [...f.a, ...(f.list ? [`${f.list.join('; ')}։`] : [])].join(' '),
      },
    })),
  },
];
---
<BaseLayout
  title="MOD Academy — դիզայնի և 3D դասընթացներ Երևանում"
  description={site.description}
  jsonLd={jsonLd}
>
  <Fragment slot="head">
    <link rel="preload" as="image" href={filmSegments[0].stillStart} media="(min-width: 900px) and (orientation: landscape)" fetchpriority="high" />
    <link rel="preload" as="image" href={filmSegments[0].stillStartMobile} media="(max-width: 899px), (orientation: portrait)" fetchpriority="high" />
  </Fragment>
  <JourneyHero />
  <About />
  <Courses />
  <Finder />
  <Learning />
  <GraduatesFeature />
  <WorkTeaser />
  <VideosTeaser />
  <Faq />
  <FinalCta />
  <Contact />
  <Lightbox />
</BaseLayout>
