---
import { Picture, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ProjectFilm from '../../components/ProjectFilm.astro';
import Lightbox from '../../components/Lightbox.astro';
import Icon from '../../components/Icon.astro';
import { projects, categoryLabels, byline, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props {
  project: Project;
}
const { project } = Astro.props;
const siteUrl = Astro.site!;
const others = projects.filter((p) => p.slug !== project.slug);

const views = await Promise.all(
  project.views.map(async (v) => {
    const large = await getImage({ src: v.image, width: 1920, format: 'webp', quality: 80 });
    const medium = await getImage({ src: v.image, width: 1280, format: 'webp', quality: 78 });
    return { ...v, large: large.src, medium: medium.src };
  }),
);

const cover = project.views[0];
const og = cover.image.width >= 1200 ? await getImage({ src: cover.image, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 }) : null;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: project.title,
    author: { '@type': 'Person', name: project.author.name, ...(project.author.instagram ? { sameAs: [project.author.instagram] } : {}) },
    about: project.course ? `«${project.course}» դասընթաց, MOD Academy` : 'MOD Academy',
    datePublished: project.sourceDate,
    url: new URL(`/student-work/${project.slug}/`, siteUrl).href,
    image: views.map((v) => new URL(v.large, siteUrl).href),
    isBasedOn: project.source,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Գլխավոր', item: new URL('/', siteUrl).href },
      { '@type': 'ListItem', position: 2, name: 'Ուսանողական աշխատանքներ', item: new URL('/student-work/', siteUrl).href },
      { '@type': 'ListItem', position: 3, name: project.title, item: new URL(`/student-work/${project.slug}/`, siteUrl).href },
    ],
  },
];
---
<BaseLayout
  title={`${project.title} — ${project.author.name} | MOD Academy`}
  description={`${byline(project)}․ ${project.title}՝ ${project.views.length} տեսք։`}
  image={og?.src}
  imageAlt={og ? cover.alt : undefined}
  jsonLd={jsonLd}
>
  <PageHeader
    title={project.title}
    kicker={`${categoryLabels[project.category]} · ${project.views.length} տեսք`}
    lead={project.summary}
    crumbs={[{ label: 'Գլխավոր', href: '/' }, { label: 'Ուսանողական աշխատանքներ', href: '/student-work/' }, { label: project.title }]}
  >
    <dl class="pj-meta" data-reveal>
      <div><dt>Հեղինակ</dt><dd>{project.author.name}{project.author.instagram && <> · <a href={project.author.instagram} target="_blank" rel="noopener">{project.author.handle}</a></>}</dd></div>
      {project.course && <div><dt>Դասընթաց</dt><dd>{project.courseSlug ? <a href={`/courses/${project.courseSlug}/`}>«{project.course}»</a> : `«${project.course}»`}</dd></div>}
    </dl>
  </PageHeader>

  <section class="pj" aria-label="Նախագծի տեսքերը">
    <div class="wrap">
      <ul class="pj-grid" role="list">
        {views.map((v, i) => (
          <li class={`pj-grid__item pj-grid__item--${i % 7}`} data-reveal="mask" style={`--i:${i % 3}`}>
            <figure>
              <button
                type="button"
                class="pj-grid__btn frame"
                data-lb-group="project"
                data-lb-src={v.large}
                data-lb-srcset={`${v.medium} 1280w, ${v.large} 1920w`}
                data-lb-alt={v.alt}
                data-lb-title={v.title}
                data-lb-credit={byline(project)}
                aria-label={`Բացել մեծ չափով՝ ${v.title}`}
              >
                <Picture src={v.image} alt={v.alt} widths={[480, 800, 1200, 1600]} sizes={i === 0 ? '(min-width: 1000px) 66vw, 92vw' : '(min-width: 1000px) 33vw, 92vw'} formats={['avif', 'webp']} fallbackFormat="webp" loading={i < 2 ? 'eager' : 'lazy'} />
                <span class="pj-grid__zoom" aria-hidden="true"><Icon name="expand" /></span>
              </button>
              <figcaption><span class="num">{String(i + 1).padStart(2, '0')}</span> {v.title}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
      {project.imageNote && <p class="pj-note muted">{project.imageNote}</p>}

      {project.film && (
        <div class="pj-film">
          <div class="pj-film__text">
            <p class="label label--red">Կինեմատոգրաֆիկ մեկնաբանություն</p>
            <h2 class="h2">Տարածությունը՝ շարժման մեջ</h2>
            <p class="muted">Նախագծի ինտերիերը՝ դանդաղ, կինեմատոգրաֆիկ կադրերում։</p>
          </div>
          <ProjectFilm film={project.film} title={project.title} />
        </div>
      )}

      <div class="pj-next">
        {project.courseSlug && (
          <a class="pj-next__card" href={`/courses/${project.courseSlug}/`}>
            <span class="label">Դասընթաց</span>
            <span class="pj-next__t">«{project.course}»</span>
            <Icon name="arrow" class="pj-next__arrow" />
          </a>
        )}
        <a class="pj-next__card" href="/student-work/">
          <span class="label">Հավաքածու</span>
          <span class="pj-next__t">{others.length ? `Եվս ${others.length} նախագիծ` : 'Բոլոր աշխատանքները'}</span>
          <Icon name="arrow" class="pj-next__arrow" />
        </a>
        <a class="pj-next__card" href="/#inquiry">
          <span class="label">Հայտ</span>
          <span class="pj-next__t">Ստեղծիր քո պորտֆոլիոն մեզ մոտ</span>
          <Icon name="arrow" class="pj-next__arrow" />
        </a>
      </div>
    </div>
  </section>
  <Lightbox />
</BaseLayout>

<style>
  .pj-meta { display: grid; gap: 10px 32px; margin-top: 28px; font-size: 0.92rem; }
  .pj-meta div { display: grid; gap: 2px; }
  .pj-meta dt { font-size: 0.7rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .pj-meta dd { margin: 0; }

  .pj { padding-block: clamp(24px, 4vw, 48px) clamp(72px, 8vw, 128px); }
  .pj-grid { display: grid; gap: 28px 16px; }
  .pj-grid__btn { position: relative; display: block; width: 100%; aspect-ratio: 1; padding: 0; border: 0; cursor: zoom-in; }
  .pj-grid__btn :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease-out); }
  .pj-grid__btn:hover :global(img) { transform: scale(1.04); }
  .pj-grid__zoom {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: rgb(244 239 232 / 0.9);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.4s ease, transform 0.5s var(--ease-out);
  }
  .pj-grid__zoom :global(svg) { width: 18px; height: 18px; }
  .pj-grid__btn:hover .pj-grid__zoom,
  .pj-grid__btn:focus-visible .pj-grid__zoom { opacity: 1; transform: none; }
  @media (hover: none) { .pj-grid__zoom { opacity: 1; transform: none; } }
  .pj-grid figcaption { margin-top: 10px; font-size: 0.9rem; font-weight: 540; }
  .pj-grid figcaption .num { color: var(--red); margin-right: 6px; }
  .pj-note { margin-top: 28px; font-size: 0.85rem; max-width: 52rem; }

  .pj-film { display: grid; gap: 24px; margin-top: clamp(56px, 7vw, 104px); padding-top: clamp(40px, 5vw, 64px); border-top: 1px solid var(--line-strong); }
  .pj-film__text { display: grid; gap: 12px; align-content: start; max-width: 30rem; }

  .pj-next { display: grid; gap: 1px; margin-top: clamp(56px, 7vw, 104px); background: var(--line-strong); border: 1px solid var(--line-strong); }
  .pj-next__card {
    position: relative;
    display: grid;
    gap: 6px;
    padding: 22px 56px 22px 22px;
    background: var(--paper);
    text-decoration: none;
    transition: background-color 0.4s ease, color 0.4s ease;
  }
  .pj-next__card .label { color: var(--muted); }
  .pj-next__t { font-family: var(--font-display); font-stretch: 87.5%; font-size: var(--fs-h3); }
  .pj-next__card :global(.pj-next__arrow) { position: absolute; right: 22px; top: 50%; width: 22px; height: 22px; transform: translateY(-50%); transition: transform 0.5s var(--ease-out); }
  .pj-next__card:hover { background: var(--ink); color: var(--paper); }
  .pj-next__card:hover .label { color: var(--on-night-muted); }
  .pj-next__card:hover :global(.pj-next__arrow) { transform: translate(6px, -50%); }

  @media (min-width: 700px) {
    .pj-meta { grid-template-columns: repeat(3, auto); justify-content: start; }
    .pj-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .pj-grid__item--0 { grid-column: 1 / -1; }
    .pj-grid__item--0 .pj-grid__btn { aspect-ratio: 16 / 10; }
    .pj-next { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (min-width: 1000px) {
    .pj-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .pj-grid__item--0 { grid-column: 1 / span 2; grid-row: span 2; }
    .pj-grid__item--0 .pj-grid__btn { aspect-ratio: auto; height: calc(100% - 34px); }
    .pj-film { grid-template-columns: minmax(0, 0.7fr) minmax(0, 1fr); align-items: center; }
  }
</style>
