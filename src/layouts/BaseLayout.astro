---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import { isIndexable } from '../../site.config.mjs';
// The display face's Armenian subset is preloaded so headlines do not reflow when it arrives.
import serifArmenian from '@fontsource-variable/noto-serif-armenian/files/noto-serif-armenian-armenian-wdth-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageAlt?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  headerCta?: string;
}

const {
  title,
  description,
  image = '/media/og/mod-academy-og.jpg',
  imageWidth = 1200,
  imageHeight = 630,
  imageAlt = 'MOD Academy — ինտերիեր դիզայնի և 3D վիզուալիզացիայի դասընթացներ Երևանում',
  noindex = false,
  jsonLd = [],
  headerCta,
} = Astro.props;

const siteUrl = Astro.site!;
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const ogImage = new URL(image, siteUrl).href;
const robots = isIndexable && !noindex ? 'index, follow, max-image-preview:large' : 'noindex, follow';

const organization = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  '@id': new URL('/#organization', siteUrl).href,
  name: site.name,
  alternateName: site.formerName,
  url: new URL('/', siteUrl).href,
  logo: new URL('/brand/mod-academy-logo.png', siteUrl).href,
  image: new URL('/media/og/mod-academy-og.jpg', siteUrl).href,
  description: site.description,
  telephone: site.phone.e164,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.streetLatin,
    addressLocality: site.address.cityLatin,
    postalCode: site.address.postalCode,
    addressCountry: 'AM',
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.lat, longitude: site.geo.lng },
  sameAs: [site.social.instagram, site.social.facebook, site.social.tiktok],
};
---
<!doctype html>
<html lang="hy" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#f4efe8" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="preload" as="font" type="font/woff2" href={serifArmenian} crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="hy_AM" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <slot name="head" />

    <script is:inline>
      // Decide before first paint whether motion is allowed, so the scroll-driven layout
      // never flashes in after the static one. The pinned hero also needs a tall enough
      // screen (see PIN_QUERY in src/scripts/hero.ts).
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        d.classList.add('motion');
        if (window.matchMedia('(min-height: 540px)').matches) d.classList.add('hero-pin');
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(organization)} />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Անցնել հիմնական բովանդակությանը</a>
    <Header ctaHref={headerCta} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
