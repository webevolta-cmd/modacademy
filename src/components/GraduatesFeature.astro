---
// Homepage graduates feature: real graduation photographs and the strongest verified stories,
// linking to the full /graduates/ page. Every claim is attributed to whoever published it.
import { Picture } from 'astro:assets';
import SectionIndex from './SectionIndex.astro';
import SplitText from './SplitText.astro';
import Icon from './Icon.astro';
import { graduationPhotos, graduateStories, attributionLabel } from '../data/graduates';
import { keep } from '../lib/text';

const photos = graduationPhotos.slice(0, 5);
const stories = graduateStories.slice(0, 3);
const fmt = (iso: string) => iso.split('-').reverse().join('.');
---
{(photos.length > 0 || stories.length > 0) && (
  <section class="grads section" id="graduates" aria-labelledby="grads-title">
    <div class="wrap">
      <SectionIndex n="05" label="Շրջանավարտներ" />
      <div class="grads__head">
        <SplitText id="grads-title" class="h1" text="Մեր շրջանավարտները" accent="շրջանավարտները" />
        <p class="lead" data-reveal>
          Իրական ավարտական պահեր և շրջանավարտների փաստագրված հաջորդ քայլերը՝ ակադեմիայի և իրենց հրապարակումներից։
        </p>
      </div>

      {photos.length > 0 && (
        <ul class="grads__photos" role="list">
          {photos.map((g, i) => (
            <li class={`grads__photo grads__photo--${i}`} data-reveal="mask" style={`--i:${i}`}>
              <figure>
                <div class="frame grads__frame">
                  <Picture src={g.image} alt={g.alt} widths={[360, 540, 720, 960]} sizes={i === 0 ? '(min-width: 1000px) 40vw, 92vw' : '(min-width: 1000px) 20vw, 46vw'} formats={['avif', 'webp']} fallbackFormat="webp" loading="lazy" />
                </div>
                <figcaption class="credit">{keep(`${g.caption} · ${fmt(g.date)}`)}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
      )}

      {stories.length > 0 && (
        <ul class="grads__stories" role="list">
          {stories.map((s, i) => (
            <li class="grads__story" data-reveal style={`--i:${i}`}>
              <a class="grads__story-link" href={`/graduates/#${s.slug}`}>
                <span class="grads__story-img frame">
                  <Picture src={s.image} alt={s.imageAlt} widths={[240, 360, 480]} sizes="(min-width: 1000px) 10vw, 28vw" formats={['avif', 'webp']} fallbackFormat="webp" loading="lazy" />
                </span>
                <span class="grads__story-body">
                  <span class="grads__story-name">{s.name}</span>
                  <span class="grads__story-course">«{s.course}» դասընթաց</span>
                  <span class="grads__story-outcome">{keep(s.outcome)}</span>
                  <span class="grads__story-src">{attributionLabel[s.attribution]} · {fmt(s.sourceDate)}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      )}

      <a class="btn grads__more" href="/graduates/" data-reveal>Շրջանավարտների պատմությունները<Icon name="arrow" class="btn__icon" /></a>
    </div>
  </section>
)}

<style>
  .grads { background: var(--paper); }
  .grads__head { display: grid; gap: 20px; margin-bottom: clamp(36px, 5vw, 64px); }

  .grads__photos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
  .grads__photo--0 { grid-column: 1 / -1; }
  .grads__frame { aspect-ratio: 4 / 5; }
  .grads__photo--0 .grads__frame { aspect-ratio: 16 / 10; }
  .grads__frame :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .grads__stories { display: grid; gap: 14px; margin-top: clamp(40px, 5vw, 72px); }
  .grads__story-link {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 16px;
    align-items: start;
    padding: 16px;
    background: var(--card);
    border: 1px solid var(--line);
    text-decoration: none;
    transition: border-color 0.4s ease, transform 0.5s var(--ease-out), box-shadow 0.5s var(--ease-out);
  }
  .grads__story-link:hover,
  .grads__story-link:focus-visible { border-color: var(--red); transform: translateY(-3px); box-shadow: 0 18px 36px -24px rgb(21 18 15 / 0.45); }
  .grads__story-img { aspect-ratio: 1; }
  .grads__story-img :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .grads__story-body { display: grid; gap: 4px; }
  .grads__story-name { font-family: var(--font-display); font-stretch: 87.5%; font-size: var(--fs-h3); line-height: 1.15; }
  .grads__story-course { font-size: 0.82rem; font-weight: 600; color: var(--red); }
  .grads__story-outcome { font-size: 0.92rem; color: var(--ink-soft); line-height: 1.5; }
  .grads__story-src { font-size: 0.76rem; color: var(--muted); }

  .grads__more { margin-top: clamp(28px, 4vw, 48px); }

  @media (min-width: 1000px) {
    .grads__head { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: end; }
    .grads__photos { grid-template-columns: repeat(4, minmax(0, 1fr)); align-items: start; }
    .grads__photo--0 { grid-column: span 2; grid-row: span 2; }
    .grads__photo--0 .grads__frame { aspect-ratio: 4 / 5; }
    .grads__photo--2,
    .grads__photo--4 { margin-top: 14%; }
    .grads__stories { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
