---
import type { Course } from '../data/courses';
import { formatFee } from '../data/courses';
import Upper from './Upper.astro';
import { keep } from '../lib/text';

interface Props {
  course: Course;
  compact?: boolean;
}
const { course, compact = false } = Astro.props;
const ask = 'Ճշտիր ընթացիկ տվյալները';
---
<dl class:list={['facts', { 'facts--compact': compact }]}>
  <div class="facts__item">
    <dt><Upper text="Տևողություն" /></dt>
    <dd class:list={{ 'is-ask': !course.duration }}>{course.duration ?? ask}</dd>
  </div>
  <div class="facts__item">
    <dt>Ժամանակացույց</dt>
    <dd class:list={{ 'is-ask': !course.schedule }}>
      {course.schedule ? (
        <span class="facts__line">
          <span>{course.schedule.frequency}</span>
          <span class="facts__time">{keep(course.schedule.length)}</span>
        </span>
      ) : (
        ask
      )}
    </dd>
  </div>
  <div class="facts__item">
    <dt>Արժեք</dt>
    <dd class:list={{ 'is-ask': !course.fee }}>
      {course.fee ? (
        <>
          <span class="num facts__fee">{formatFee(course.fee.amount)}</span>
          <span class="facts__unit">{course.fee.unit}</span>
        </>
      ) : (
        ask
      )}
    </dd>
  </div>
  <div class="facts__item">
    <dt><Upper text="Ձևաչափ" /></dt>
    <dd>{course.format}{course.level && <span class="facts__level">{course.level}</span>}</dd>
  </div>
</dl>

<style>
  .facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }

  .facts__item { background: var(--card); padding: 12px 14px; display: grid; gap: 4px; align-content: start; }

  .facts dt {
    font-size: 0.7rem;
    font-weight: 600;
    font-stretch: 87.5%;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .facts dd { margin: 0; font-size: 0.95rem; line-height: 1.4; font-weight: 500; display: grid; gap: 4px; }
  .facts dd.is-ask { color: var(--muted); font-weight: 400; font-size: 0.88rem; }

  .facts__line { display: flex; flex-wrap: wrap; column-gap: 8px; }
  .facts__time { color: var(--muted); font-variant-numeric: tabular-nums; }
  .facts__fee { font-size: 1.15rem; font-weight: 500; }
  .facts__unit { display: block; color: var(--muted); font-size: 0.85rem; font-weight: 400; }
  .facts__level { display: block; color: var(--red); font-size: 0.82rem; font-weight: 560; }

  .facts--compact .facts__item { padding: 10px 12px; }

  @media (min-width: 1200px) {
    .facts:not(.facts--compact) { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>
