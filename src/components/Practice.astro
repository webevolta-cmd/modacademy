---
import { Picture, getImage } from 'astro:assets';
import SectionIndex from './SectionIndex.astro';
import SplitText from './SplitText.astro';
import Icon from './Icon.astro';
import { practice } from '../data/media';

const items = await Promise.all(
  practice.map(async (p) => {
    const large = await getImage({ src: p.image, width: 720, format: 'webp', quality: 86 });
    return { ...p, large: large.src };
  }),
);

const partners = [...new Map(practice.filter((p) => p.partnerUrl).map((p) => [p.partner, p])).values()];

function formatDate(iso: string) {
  const [y, m, d] = iso.split('-');
  return `${d}.${m}.${y}`;
}
---
<section class="practice section" id="practice" aria-labelledby="practice-title">
  <div class="wrap">
    <SectionIndex n="06" label="Գործնական դասեր" />
    <div class="practice__head">
      <SplitText id="practice-title" class="h1" text="Ուսուցում լսարանից դուրս" accent="դուրս" />
      <div class="practice__intro" data-reveal>
        <p class="lead">
          Նյութը պետք է տեսնել և շոշափել։ «Ինտերիեր դիզայն» դասընթացի ուսանողները գործնական դասեր են ունենում Երևանի
          դիզայնի սրահներում, իսկ վաճառքի դասերն անցնում են ինտերակտիվ ձևաչափով։
        </p>
        <ul class="practice__partners" role="list" aria-label="Գործնական դասերի վայրեր">
          {partners.map((p) => (
            <li>
              <a href={p.partnerUrl} target="_blank" rel="noopener" class="tag">
                {p.partner}<Icon name="arrow-up-right" class="practice__ext" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <ul class="practice__grid" role="list">
      {items.map((p, i) => (
        <li class={`practice__item practice__item--${i}`} data-reveal style={`--i:${i % 3}`}>
          <figure>
            <button
              type="button"
              class="practice__btn frame"
              data-lb-group="practice"
              data-lb-src={p.large}
              data-lb-alt={p.alt}
              data-lb-title={p.caption}
              data-lb-credit={`${p.partner} · ${p.course} · ${formatDate(p.date)}`}
              aria-label={`Բացել մեծ չափով՝ ${p.caption}`}
            >
              <Picture
                src={p.image}
                alt={p.alt}
                widths={[360, 540, 720]}
                sizes="(min-width: 1000px) 30vw, (min-width: 600px) 46vw, 88vw"
                formats={['avif', 'webp']}
                loading="lazy"
                data-parallax
                style="--ps:1.12"
              />
            </button>
            <figcaption class="practice__cap">
              <span class="label">{p.partner}</span>
              <span class="practice__t">{p.caption}</span>
              <span class="practice__meta">{p.course} · <time datetime={p.date}>{formatDate(p.date)}</time></span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
    <p class="practice__note muted" data-reveal>
      Լուսանկարները՝ ակադեմիայի Instagram էջում հրապարակված տեսանյութերից (2026 թ. հոկտեմբեր)։
    </p>
  </div>
</section>

<style>
  .practice { background: var(--paper-2); }

  .practice__head { display: grid; gap: 24px; margin-bottom: clamp(40px, 5vw, 72px); }
  .practice__intro { display: grid; gap: 20px; }
  .practice__partners { display: flex; flex-wrap: wrap; gap: 8px; }
  .practice__partners .tag { text-decoration: none; transition: background-color 0.3s ease, color 0.3s ease; }
  .practice__partners .tag:hover { background: var(--ink); color: var(--paper); }
  .practice__partners :global(.practice__ext) { width: 14px; height: 14px; }

  .practice__grid {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(240px, 78%);
    gap: 14px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 12px;
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    scroll-padding-inline: var(--gutter);
    scrollbar-width: thin;
  }

  .practice__item { scroll-snap-align: start; }

  .practice__btn {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    padding: 0;
    border: 0;
    cursor: zoom-in;
  }

  .practice__btn :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .practice__cap { display: grid; gap: 4px; margin-top: 12px; }
  .practice__cap .label { color: var(--red); }
  .practice__t { font-weight: 520; line-height: 1.4; }
  .practice__meta { font-size: 0.8rem; color: var(--muted); }

  .practice__note { margin-top: 28px; font-size: 0.82rem; }

  @media (min-width: 600px) {
    .practice__grid { grid-auto-columns: minmax(260px, 44%); }
  }

  @media (min-width: 1000px) {
    .practice__head { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: end; }

    .practice__grid {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-columns: auto;
      overflow: visible;
      margin-inline: 0;
      padding-inline: 0;
      gap: clamp(40px, 4vw, 64px) clamp(16px, 2vw, 32px);
    }

    .practice__item--1,
    .practice__item--4 { margin-top: 18%; }
    .practice__item--2,
    .practice__item--5 { margin-top: 8%; }
  }
</style>
