---
import Icon from './Icon.astro';
import { site } from '../data/site';
import { student } from '../data/media';
---
<section class="hero" id="top" data-hero aria-labelledby="hero-title">
  <div class="hero__stage" data-hero-stage>
    <div class="hero__window" data-hero-window aria-hidden="true">
      <div class="hero__media" data-hero-media>
        <picture class="hero__poster" data-hero-poster>
          <source
            media="(max-aspect-ratio: 4/5)"
            srcset="/media/hero/hero-900x1200-poster.webp"
            type="image/webp"
            width="900"
            height="1200"
          />
          <img
            src="/media/hero/hero-1440-poster.webp"
            alt=""
            width="1440"
            height="1440"
            fetchpriority="high"
            decoding="async"
          />
        </picture>
        <video
          data-hero-video
          muted
          playsinline
          preload="none"
          disablepictureinpicture
          disableremoteplayback
          tabindex="-1"
          data-src-desktop="/media/hero/hero-1440.mp4"
          data-src-mobile="/media/hero/hero-900x1200.mp4"
        ></video>
        <div class="hero__shade" data-hero-shade></div>
      </div>
    </div>
    <div class="hero__slot" data-hero-slot aria-hidden="true"><span class="hero__ticks"></span></div>

    <div class="hero__intro" data-hero-intro>
      <p class="label hero__eyebrow"><span class="hero__dot" aria-hidden="true"></span>MOD Academy · Երևան</p>
      <h1 id="hero-title" class="display hero__title">
        <span class="visually-hidden">MOD Academy — </span>Ստեղծի՛ր ապագայիդ <em class="accent">պրոֆեսիոնալ</em> ուղին
      </h1>
      <p class="lead hero__lead">
        Ինտերիեր դիզայն, 3Ds Max և Corona Renderer, գրաֆիկ դիզայն ու վաճառքի կառավարում՝ գործնական դասերով և
        ուսանողական պորտֆոլիոյով։
      </p>
      <div class="hero__ctas">
        <a class="btn btn--red" href="#courses">
          Բացահայտել դասընթացները<Icon name="arrow" class="btn__icon" />
        </a>
        <a class="btn btn--ghost" href="#work">Դիտել ուսանողների աշխատանքները</a>
      </div>
      <dl class="hero__stats">
        {site.stats.map((s) => (
          <div>
            <dt class="visually-hidden">{s.label}</dt>
            <dd>
              <span class="num hero__stat-n">{s.value}{s.suffix}</span>
              <span class="hero__stat-l">{s.label}</span>
            </dd>
          </div>
        ))}
      </dl>
    </div>

    <p class="hero__credit" data-hero-credit>
      <span class="label">Ուսանողական աշխատանք · «{student.course}»</span>
      <span>{student.name}-ի ռենդերի հիման վրա ստեղծված AI կինեմատոգրաֆիկ շարժում</span>
    </p>

    <div class="hero__chapters" data-hero-chapters>
      <article class="hero__chapter" data-chapter>
        <p class="label">01 · Տեսնել տարածությունը</p>
        <h2 class="h1">Լույս, նյութ, համամասնություն</h2>
        <p>Դիզայնը սկսվում է ուշադրությունից՝ ինչպես է լույսն ընկնում պատին, ինչպես են նյութերը խոսում միմյանց հետ։</p>
      </article>
      <article class="hero__chapter" data-chapter>
        <p class="label">02 · Ուսանողի աշխատանք</p>
        <h2 class="h1">Այս ինտերիերը ստեղծել է շրջանավարտը</h2>
        <p>
          Վիզուալիզացիան «{student.course}» դասընթացի շրջանավարտ {student.name}-ի պորտֆոլիոյից է։ Տեսահոլովակը
          նրա ռենդերի կինեմատոգրաֆիկ ներկայացումն է։
        </p>
      </article>
      <article class="hero__chapter" data-chapter>
        <p class="label">03 · Հերթը քոնն է</p>
        <h2 class="h1">Սկսիր քո առաջին նախագիծը</h2>
        <div class="hero__ctas">
          <a class="btn btn--light" href="#courses">Ընտրել դասընթաց<Icon name="arrow" class="btn__icon" /></a>
          <a class="btn btn--ghost-light" href="#inquiry">Ստանալ մանրամասներ</a>
        </div>
      </article>
    </div>

    <div class="hero__progress" aria-hidden="true"><span data-hero-bar></span></div>
    <a class="hero__scroll" href="#about" data-hero-scroll>
      <span>Թերթիր</span><span class="hero__scroll-line" aria-hidden="true"></span>
    </a>
  </div>
</section>

<style>
  /* ── Static layout (no JS / reduced motion): editorial split, no pinning ── */
  .hero {
    --s-top: calc(var(--header-h) + 14px);
    --s-right: 12px;
    --s-bottom: 46svh;
    --s-left: 12px;
    position: relative;
    background: var(--paper);
  }

  .hero__stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding-top: var(--s-top);
  }

  .hero__window {
    position: relative;
    margin-inline: var(--s-left) var(--s-right);
    aspect-ratio: 3 / 4;
    max-height: 62svh;
    overflow: hidden;
    background: var(--paper-3);
  }

  .hero__media,
  .hero__poster,
  .hero__poster img,
  .hero__media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero__poster img,
  .hero__media video {
    object-fit: cover;
    object-position: 50% 50%;
  }

  .hero__media video { opacity: 0; transition: opacity 0.6s ease; }
  .hero__media video.is-live { opacity: 1; }

  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(17 15 13 / 0) 30%, rgb(17 15 13 / 0.72) 100%),
      linear-gradient(90deg, rgb(17 15 13 / 0.55) 0%, rgb(17 15 13 / 0) 62%);
    opacity: 0;
  }

  .hero__slot { display: none; }

  .hero__intro {
    padding: 28px var(--gutter) 8px;
    display: grid;
    gap: 18px;
    align-content: start;
  }

  .hero__eyebrow { color: var(--muted); }

  .hero__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 2px solid var(--red);
    border-left-color: transparent;
    transform: rotate(-45deg);
  }

  .hero__title {
    font-size: clamp(2.3rem, min(1.1rem + 5.2vw, 9svh), 6.4rem);
    max-width: 11ch;
  }

  .hero__lead { max-width: 32em; }

  .hero__ctas { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 4px; }

  .hero__stats {
    display: flex;
    gap: clamp(24px, 4vw, 56px);
    margin-top: 10px;
    padding-top: 18px;
    border-top: 1px solid var(--line);
  }

  .hero__stats dd { margin: 0; display: grid; gap: 2px; }

  .hero__stat-n { font-size: clamp(1.7rem, 1.2rem + 1.4vw, 2.6rem); line-height: 1; font-weight: 400; }

  .hero__stat-l { font-size: 0.82rem; color: var(--muted); }

  .hero__credit {
    display: grid;
    gap: 4px;
    padding: 14px var(--gutter) 0;
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--muted);
  }

  .hero__credit .label { font-size: 0.68rem; color: var(--ink); }

  .hero__chapters {
    display: grid;
    gap: 28px;
    padding: 48px var(--gutter) 72px;
  }

  .hero__chapter { display: grid; gap: 12px; max-width: 36rem; }
  .hero__chapter .label { color: var(--red); }
  .hero__chapter .h1 { font-size: var(--fs-h2); }
  .hero__chapter p:not(.label) { color: var(--ink-soft); }

  .hero__chapter .btn--light { --btn-bg: var(--ink); --btn-fg: var(--paper); }
  .hero__chapter .btn--ghost-light { --btn-fg: var(--ink); border-color: var(--line-strong); }

  .hero__progress,
  .hero__scroll { display: none; }

  @media (min-width: 900px) {
    .hero {
      --s-top: calc(var(--header-h) + 12px);
      --s-right: clamp(12px, 1.6vw, 28px);
      --s-bottom: clamp(16px, 3vh, 36px);
      --s-left: 47vw;
    }

    .hero__stage {
      grid-template-columns: 47vw minmax(0, 1fr);
      min-height: 100svh;
      padding-top: var(--s-top);
      padding-bottom: var(--s-bottom);
    }

    .hero__window {
      grid-column: 2;
      grid-row: 1 / span 3;
      margin: 0 var(--s-right) 0 0;
      aspect-ratio: auto;
      max-height: none;
      min-height: calc(100svh - var(--s-top) - var(--s-bottom));
    }

    .hero__intro {
      grid-column: 1;
      grid-row: 1;
      align-self: center;
      padding: 0 clamp(24px, 3vw, 56px) 0 var(--gutter);
      gap: 22px;
    }

    .hero__credit {
      grid-column: 1;
      grid-row: 2;
      align-self: end;
      padding: 0 32px 0 var(--gutter);
      max-width: 40rem;
    }

    .hero__chapters {
      grid-column: 1 / -1;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 40px;
      padding-top: 72px;
    }
  }

  /* ── Scroll-driven mode (JS + motion allowed). html.motion is set before first paint. ── */
  :global(.motion) .hero { height: 330svh; }

  :global(.motion) .hero__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 0;
    padding: 0;
    overflow: hidden;
    display: block;
    background: var(--paper);
  }

  :global(.motion) .hero__window {
    position: absolute;
    inset: 0;
    margin: 0;
    aspect-ratio: auto;
    max-height: none;
    min-height: 0;
    clip-path: inset(var(--s-top) var(--s-right) var(--s-bottom) var(--s-left));
    will-change: clip-path;
    z-index: 0;
  }

  :global(.motion) .hero__media {
    transform: scale(var(--z, 1.06));
    transform-origin: 50% 46%;
    will-change: transform;
  }

  :global(.motion) .hero__slot {
    display: block;
    position: absolute;
    top: var(--s-top);
    right: var(--s-right);
    bottom: var(--s-bottom);
    left: var(--s-left);
    pointer-events: none;
    z-index: 1;
  }

  :global(.motion) .hero__ticks {
    position: absolute;
    inset: -7px;
    opacity: var(--ticks, 1);
    background:
      linear-gradient(var(--ink), var(--ink)) top left / 18px 1px no-repeat,
      linear-gradient(var(--ink), var(--ink)) top left / 1px 18px no-repeat,
      linear-gradient(var(--ink), var(--ink)) top right / 18px 1px no-repeat,
      linear-gradient(var(--ink), var(--ink)) top right / 1px 18px no-repeat,
      linear-gradient(var(--ink), var(--ink)) bottom left / 18px 1px no-repeat,
      linear-gradient(var(--ink), var(--ink)) bottom left / 1px 18px no-repeat,
      linear-gradient(var(--ink), var(--ink)) bottom right / 18px 1px no-repeat,
      linear-gradient(var(--ink), var(--ink)) bottom right / 1px 18px no-repeat;
  }

  :global(.motion) .hero__shade { opacity: var(--shade, 0); }

  :global(.motion) .hero__intro {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    top: calc(100svh - var(--s-bottom));
    padding: 22px var(--gutter) 0;
    gap: 14px;
    align-content: start;
    z-index: 2;
    opacity: var(--intro-o, 1);
    transform: translate3d(0, var(--intro-y, 0px), 0);
    filter: blur(var(--intro-b, 0px));
    will-change: transform, opacity, filter;
  }

  :global(.motion) .hero__intro.is-gone { visibility: hidden; }

  :global(.motion) .hero__credit {
    position: absolute;
    left: calc(var(--s-left) + 14px);
    right: calc(var(--s-right) + 14px);
    bottom: calc(var(--s-bottom) + 12px);
    z-index: 2;
    justify-self: start;
    width: fit-content;
    max-width: min(26rem, calc(100% - var(--s-left) - var(--s-right) - 28px));
    padding: 9px 12px;
    color: rgb(255 255 255 / 0.94);
    background: rgb(17 15 13 / 0.52);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    opacity: var(--credit-o, 1);
  }

  :global(.motion) .hero__credit .label { color: #fff; }

  :global(.motion) .hero__chapters {
    position: absolute;
    inset: 0;
    display: block;
    padding: 0;
    z-index: 3;
    pointer-events: none;
    color: var(--on-night);
  }

  :global(.motion) .hero__chapter {
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: clamp(88px, 14svh, 150px);
    max-width: 40rem;
    opacity: 0;
    visibility: hidden;
    transform: translate3d(0, 24px, 0);
    filter: blur(6px);
    will-change: transform, opacity, filter;
  }

  :global(.motion) .hero__chapter.is-on { visibility: visible; pointer-events: auto; }
  :global(.motion) .hero__chapter .label { color: #ff8a82; }
  :global(.motion) .hero__chapter .h1 { font-size: var(--fs-h1); color: #fff; }
  :global(.motion) .hero__chapter p:not(.label) { color: rgb(241 235 226 / 0.9); font-size: var(--fs-lead); line-height: 1.5; }
  :global(.motion) .hero__chapter .btn--light { --btn-bg: var(--paper); --btn-fg: var(--ink); }
  :global(.motion) .hero__chapter .btn--ghost-light { --btn-fg: var(--on-night); border-color: rgb(241 235 226 / 0.45); }

  :global(.motion) .hero__progress {
    display: block;
    position: absolute;
    right: 10px;
    top: 50%;
    width: 1px;
    height: 120px;
    margin-top: -60px;
    background: rgb(255 255 255 / 0.28);
    z-index: 3;
    opacity: var(--bar-o, 0);
  }

  :global(.motion) .hero__progress span {
    position: absolute;
    inset: 0;
    background: #fff;
    transform-origin: top;
    transform: scaleY(var(--p, 0));
  }

  :global(.motion) .hero__scroll {
    display: none;
  }

  @media (min-width: 900px) {
    :global(.motion) .hero { height: 340svh; }

    :global(.motion) .hero__intro {
      top: var(--s-top);
      bottom: var(--s-bottom);
      right: auto;
      width: var(--s-left);
      padding: 0 clamp(24px, 3vw, 56px) 0 var(--gutter);
      align-content: center;
      gap: 22px;
    }

    :global(.motion) .hero__credit {
      left: calc(var(--s-left) + 22px);
      bottom: calc(var(--s-bottom) + 20px);
      max-width: 26rem;
    }

    :global(.motion) .hero__chapter { left: var(--gutter); bottom: clamp(72px, 12svh, 140px); }

    :global(.motion) .hero__progress { right: clamp(18px, 2vw, 32px); }

    :global(.motion) .hero__scroll {
      position: absolute;
      left: var(--gutter);
      bottom: 22px;
      display: none;
    }
  }

  @media (max-width: 899px) {
    :global(.motion) .hero { --s-bottom: 49svh; }
    :global(.motion) .hero__title { font-size: clamp(2rem, 1.2rem + 4.6vw, 3rem); max-width: 13ch; }
    :global(.motion) .hero__lead { font-size: 1rem; line-height: 1.5; }
    :global(.motion) .hero__stats { display: none; }
    :global(.motion) .hero__ctas .btn--ghost { display: none; }
  }

  @media (max-width: 899px) and (max-height: 720px) {
    :global(.motion) .hero__lead { display: none; }
  }

  @media (min-width: 900px) and (max-height: 760px) {
    :global(.motion) .hero__stats { display: none; }
  }
</style>
