---
import { Picture } from 'astro:assets';
import SectionIndex from './SectionIndex.astro';
import SplitText from './SplitText.astro';
import { site } from '../data/site';
import { courses } from '../data/courses';
import { practice, work, student } from '../data/media';
import { keep } from '../lib/text';

const pillars = [
  {
    t: 'Գործնական դասեր',
    d: 'Ուսանողները դասերի են գնում դիզայնի սրահներ՝ կահույքը, լուսավորությունը և նյութերը տեսնելու իրական չափերով։',
  },
  {
    t: 'Աշխատանք՝ պորտֆոլիոյի համար',
    d: 'Ուսանողական աշխատանքներն ակադեմիան ներկայացնում է որպես պորտֆոլիո՝ հեղինակի անունով։',
  },
  {
    t: 'Ստուդիա',
    d: `Ակադեմիայի Instagram էջում որպես «մեր ստուդիա» նշված է ${site.studio.name} ինտերիերի և ճարտարապետության ստուդիան։`,
  },
  {
    t: 'Վկայական',
    d: 'Ըստ ակադեմիայի՝ դասընթացի ավարտին տրվում է վկայական։',
  },
];

const figures = [
  ...site.stats.map((s) => ({ ...s, note: true })),
  { value: courses.length, suffix: '', label: 'դասընթաց', note: false },
];
const format = (n: number) => n.toLocaleString('en-US').replace(/,/g, '\u202f');
---
<section class="about section" id="about" aria-labelledby="about-title">
  <div class="wrap">
    <SectionIndex n="01" label="Ակադեմիայի մասին" />
    <div class="about__head">
      <SplitText
        id="about-title"
        class="h1 about__title"
        text="Դիզայն սովորում են՝ տեսնելով, փորձելով և ստեղծելով"
        accent="ստեղծելով"
      />
      <div class="about__intro" data-reveal>
        <p class="lead">
          {site.name}-ն Երևանում գործող ուսումնական կենտրոն է՝ ինտերիեր դիզայնի, 3D վիզուալիզացիայի, գրաֆիկ
          դիզայնի և վաճառքի կառավարման դասընթացներով։
        </p>
        <p class="muted">
          Նախկինում հայտնի էր որպես {site.formerName}։ Դասերն անցնում են Տիգրան Մեծի պողոտայում՝ Հանրապետության
          հրապարակի մոտ, իսկ գործնական դասերը՝ Երևանի դիզայնի սրահներում։
        </p>
      </div>
    </div>

    <ul class="about__figures" role="list">
      {figures.map((f, i) => (
        <li class="about__figure" data-reveal style={`--i:${i}`}>
          <span class="visually-hidden">{format(f.value)}{f.suffix} {f.label}{f.note && ` (${site.statsSource.charAt(0).toLowerCase()}${site.statsSource.slice(1)})`}</span>
          <span class="num about__n" aria-hidden="true" data-count={f.value} data-suffix={f.suffix}>{format(f.value)}{f.suffix}</span>
          <span class="about__l" aria-hidden="true">{f.label}{f.note && <sup>*</sup>}</span>
        </li>
      ))}
    </ul>
    <p class="about__source muted" aria-hidden="true">* {site.statsSource}</p>

    <div class="about__visual">
      <figure class="about__img about__img--a" data-reveal="fade">
        <div class="frame about__frame-a">
          <Picture
            src={practice[2].image}
            alt={practice[2].alt}
            widths={[360, 540, 720]}
            sizes="(min-width: 900px) 30vw, 70vw"
            formats={['avif', 'webp']}
                fallbackFormat="webp"
            loading="lazy"
            data-parallax
            style="--ps:1.14"
          />
        </div>
        <figcaption class="credit">{keep(`Գործնական դաս ${practice[2].partner}-ում · ակադեմիայի հրապարակումից, 2026 թ. հոկտեմբեր`)}</figcaption>
      </figure>
      <figure class="about__img about__img--b" data-reveal="fade">
        <div class="frame about__frame-b">
          <Picture
            src={work[1].image}
            alt={work[1].alt}
            widths={[480, 720, 1080, 1440]}
            sizes="(min-width: 900px) 46vw, 92vw"
            formats={['avif', 'webp']}
                fallbackFormat="webp"
            loading="lazy"
            data-parallax
            style="--ps:1.16"
          />
        </div>
        <figcaption class="credit">Ուսանողական աշխատանք · {student.name}, «{student.course}» դասընթաց</figcaption>
      </figure>
      <ul class="about__pillars" role="list" data-reveal-group>
        {pillars.map((p, i) => (
          <li data-reveal style={`--i:${i}`}>
            <span class="about__pn num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="h3">{p.t}</h3>
            <p class="muted">{p.d}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .about { background: var(--paper); }

  .about__head {
    display: grid;
    gap: clamp(24px, 4vw, 64px);
  }

  .about__title { max-width: 15ch; }

  .about__intro { display: grid; gap: 16px; max-width: 36rem; align-self: end; }

  .about__figures {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 12px 20px;
    margin-top: clamp(48px, 6vw, 96px);
    border-top: 1px solid var(--line-strong);
  }

  .about__figure { display: grid; gap: 6px; align-content: start; padding-top: 18px; }

  .about__n {
    font-size: clamp(2.4rem, 1.4rem + 4vw, 5.6rem);
    line-height: 0.95;
    font-weight: 330;
    letter-spacing: -0.02em;
  }

  .about__l { font-size: 0.88rem; color: var(--muted); line-height: 1.35; }
  .about__l sup { color: var(--red); }

  .about__source { margin-top: 14px; font-size: 0.78rem; }

  .about__visual {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 16px;
    margin-top: clamp(56px, 7vw, 120px);
    align-items: start;
  }

  .about__img--a { grid-column: 1 / span 7; margin-top: 18%; }
  .about__img--b { grid-column: 3 / span 10; grid-row: 2; margin-top: 24px; }
  .about__frame-a { aspect-ratio: 4 / 5; }
  .about__frame-b { aspect-ratio: 1 / 1; }

  .about__frame-a :global(img),
  .about__frame-b :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .about__pillars {
    grid-column: 1 / -1;
    display: grid;
    gap: 28px;
    margin-top: 40px;
  }

  .about__pillars li { display: grid; gap: 8px; padding-top: 16px; border-top: 1px solid var(--line); }
  .about__pn { color: var(--red); font-size: 0.9rem; }

  @media (min-width: 900px) {
    .about__head { grid-template-columns: 1.25fr 1fr; align-items: end; }

    .about__visual { gap: clamp(16px, 2vw, 32px); }
    .about__img--a { grid-column: 1 / span 4; grid-row: 1 / span 2; margin-top: 30%; }
    .about__img--b { grid-column: 5 / span 8; grid-row: 1; margin-top: 0; }
    .about__pillars {
      grid-column: 5 / span 8;
      grid-row: 2;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 36px 40px;
      margin-top: 24px;
    }
  }
</style>
