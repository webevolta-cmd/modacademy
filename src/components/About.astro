---
import SectionIndex from './SectionIndex.astro';
import SplitText from './SplitText.astro';
import { site } from '../data/site';
import { courses } from '../data/courses';
import { keep } from '../lib/text';

// How the section reads the academy's figures (the values themselves come from its bio).
const statLabels: Record<string, string> = { 'տարի': 'տարվա փորձ' };
const figures = [
  ...site.stats.map((s) => ({ ...s, label: statLabels[s.label] ?? s.label, note: true })),
  { value: courses.length, suffix: '', label: 'դասընթաց', note: false },
];
// Armenian convention leaves four-digit numbers unspaced (1000+), as in the academy's own bio.
const format = (n: number) => String(n);
---
<section class="about section" id="about" aria-labelledby="about-title">
  <div class="wrap">
    <SectionIndex n="01" label="Ակադեմիայի մասին" />
    <div class="about__head">
      <SplitText
        id="about-title"
        class="h1 about__title"
        text="Այստեղ սովորում ես՝ տեսնելով, փորձելով և ստեղծելով"
        accent="ստեղծելով"
      />
      <div class="about__intro" data-reveal>
        <p class="lead">
          {keep(
            `Քո հետաքրքրությունը վերածիր մասնագիտության ${site.name}-ում։ Սովորիր ինտերիեր դիզայն, 3D վիզուալիզացիա, գրաֆիկ դիզայն կամ վաճառքի կառավարում՝ Երևանում, փորձառու մասնագետների աջակցությամբ։ Ձեռք բեր գործնական հմտություններ, կիրառիր սովորածդ իրական առաջադրանքներում և վստահ սկսիր քո մասնագիտական նոր ուղին։`,
          )}
        </p>
        <p class="muted">
          Մենք Տիգրան Մեծի պողոտայում ենք՝ Հանրապետության հրապարակի մոտ, իսկ ինտերիերի գործնական դասերի համար միասին այցելում ենք Երևանի դիզայնի սրահները։
        </p>
      </div>
    </div>

    <ul class="about__figures" role="list">
      {figures.map((f, i) => (
        <li class="about__figure" data-reveal style={`--i:${i}`}>
          <span class="visually-hidden">{format(f.value)}{f.suffix} {f.label}</span>
          <span class="num about__n" aria-hidden="true" data-count={f.value} data-suffix={f.suffix}>{format(f.value)}{f.suffix}</span>
          <span class="about__l" aria-hidden="true">{f.label}</span>
        </li>
      ))}
    </ul>

  </div>
</section>

<style>
  .about { background: var(--paper); }

  .about__head {
    display: grid;
    gap: clamp(24px, 4vw, 64px);
  }

  .about__title { max-width: 15ch; }

  .about__intro { display: grid; gap: 16px; max-width: 36rem; align-self: end; }

  .about__figures {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 12px 20px;
    margin-top: clamp(48px, 6vw, 96px);
    border-top: 1px solid var(--line-strong);
  }

  .about__figure { display: grid; gap: 6px; align-content: start; padding-top: 18px; }

  .about__n {
    font-size: clamp(2.4rem, 1.4rem + 4vw, 5.6rem);
    line-height: 0.95;
    font-weight: 330;
    letter-spacing: -0.02em;
  }

  .about__l { font-size: 0.88rem; color: var(--muted); line-height: 1.35; }
  .about__l sup { color: var(--red); }

  .about__source { margin-top: 14px; font-size: 0.78rem; }

  @media (min-width: 900px) {
    .about__head { grid-template-columns: 1.25fr 1fr; align-items: end; }

  }
</style>
