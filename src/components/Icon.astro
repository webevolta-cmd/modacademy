---
// Minimal stroke icon set (24×24 grid, 1.5px strokes). Decorative by default.
interface Props {
  name:
    | 'arrow'
    | 'arrow-down'
    | 'arrow-up-right'
    | 'phone'
    | 'mail'
    | 'pin'
    | 'instagram'
    | 'facebook'
    | 'tiktok'
    | 'close'
    | 'plus'
    | 'chevron-left'
    | 'chevron-right'
    | 'expand'
    | 'check'
    | 'clock'
    | 'calendar'
    | 'menu';
  class?: string;
  label?: string;
}
const { name, class: className, label } = Astro.props;
const a11y = label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true', focusable: 'false' };
---
<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  xmlns="http://www.w3.org/2000/svg"
  {...a11y}
>
  {name === 'arrow' && <path d="M4 12h15M13 6l6 6-6 6" />}
  {name === 'arrow-down' && <path d="M12 4v15M6 13l6 6 6-6" />}
  {name === 'arrow-up-right' && <path d="M7 17 17 7M8 7h9v9" />}
  {name === 'phone' && (
    <path d="M5 4h3.2l1.6 4-2 1.3a11 11 0 0 0 6.9 6.9l1.3-2 4 1.6V19a1.5 1.5 0 0 1-1.6 1.5A16 16 0 0 1 3.5 5.6 1.5 1.5 0 0 1 5 4Z" />
  )}
  {name === 'mail' && (
    <>
      <rect x="3.5" y="5.5" width="17" height="13" rx="1.5" />
      <path d="m4 7 8 6 8-6" />
    </>
  )}
  {name === 'pin' && (
    <>
      <path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0C18.5 15.4 12 21 12 21Z" />
      <circle cx="12" cy="10" r="2.3" />
    </>
  )}
  {name === 'instagram' && (
    <>
      <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none" />
    </>
  )}
  {name === 'facebook' && <path d="M14.5 8.5H16V5.6h-2.1c-2.2 0-3.4 1.4-3.4 3.6v1.9H8.3V14h2.2v6.4h3V14h2.3l.4-2.9h-2.7V9.6c0-.7.3-1.1 1-1.1Z" />}
  {name === 'tiktok' && <path d="M14 4v10.6a3.4 3.4 0 1 1-3.4-3.4M14 4c.4 2.4 2 4 4.5 4.3" />}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
  {name === 'chevron-left' && <path d="m15 5-7 7 7 7" />}
  {name === 'chevron-right' && <path d="m9 5 7 7-7 7" />}
  {name === 'expand' && <path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" />}
  {name === 'check' && <path d="m5 12.5 4.5 4.5L19 7.5" />}
  {name === 'clock' && (
    <>
      <circle cx="12" cy="12" r="8.5" />
      <path d="M12 7.5V12l3 2" />
    </>
  )}
  {name === 'calendar' && (
    <>
      <rect x="4" y="5.5" width="16" height="14.5" rx="1.5" />
      <path d="M4 10h16M8.5 3.5v4M15.5 3.5v4" />
    </>
  )}
  {name === 'menu' && <path d="M4 8h16M4 16h16" />}
</svg>
