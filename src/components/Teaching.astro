---
import { Picture } from 'astro:assets';
import SectionIndex from './SectionIndex.astro';
import SplitText from './SplitText.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';
import { extraImages } from '../data/media';
---
<section class="teach section" id="teaching" aria-labelledby="teach-title">
  <div class="wrap teach__grid">
    <div class="teach__text">
      <SectionIndex n="07" label="Դասախոսներ" />
      <SplitText id="teach-title" class="h1" text="Ուղղորդում՝ փորձառու մասնագետներից" accent="մասնագետներից" />
      <div class="teach__body" data-reveal>
        <p class="lead">
          Ըստ ակադեմիայի՝ դասընթացները վարում են փորձառու դասախոսներ, իսկ գործնական դասերի ժամանակ ուսանողներին իրենց
          փորձով կիսվում են նաև գործընկեր սրահների մասնագետները։
        </p>
        <p class="muted">
          Յուրաքանչյուր խմբի դասախոսի և նրա մասնագիտական փորձի մասին կարող եք հարցնել հայտ ուղարկելիս կամ
          զանգահարելով։
        </p>
      </div>
      <a class="teach__studio" href={site.studio.instagram} target="_blank" rel="noopener" data-reveal>
        <span class="label label--red">Ակադեմիայի ստուդիան</span>
        <span class="teach__studio-name">{site.studio.name}</span>
        <span class="teach__studio-meta">{site.studio.handle}<Icon name="arrow-up-right" /></span>
      </a>
    </div>

    <div class="teach__media">
      <figure class="teach__fig teach__fig--a" data-reveal="fade">
        <div class="frame teach__frame">
          <Picture
            src={extraImages.salesTrainer}
            alt="Դասախոսը բացատրում է նյութը «Վաճառքի կառավարում» դասընթացի ժամանակ"
            widths={[360, 540, 720]}
            sizes="(min-width: 1000px) 26vw, 60vw"
            formats={['avif', 'webp']}
            loading="lazy"
            data-parallax
            style="--ps:1.12"
          />
        </div>
        <figcaption class="credit">«Վաճառքի կառավարում» դասընթացի դաս, 2026 թ. հոկտեմբեր</figcaption>
      </figure>
      <figure class="teach__fig teach__fig--b" data-reveal="fade" style="--i:1">
        <div class="frame teach__frame">
          <Picture
            src={extraImages.classisTable}
            alt="Ուսանողները գործնական դասի ժամանակ ուսումնասիրում են գործվածքների նմուշները"
            widths={[360, 540, 720]}
            sizes="(min-width: 1000px) 22vw, 50vw"
            formats={['avif', 'webp']}
            loading="lazy"
            data-parallax
            style="--ps:1.12"
          />
        </div>
        <figcaption class="credit">Գործնական դաս Classis Decor Armenia-ում, 08.10.2026</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .teach { background: var(--paper); }
  .teach__grid { display: grid; gap: clamp(40px, 6vw, 96px); }
  .teach__text { display: grid; gap: 24px; align-content: start; }
  .teach__body { display: grid; gap: 14px; max-width: 36rem; }

  .teach__studio {
    display: grid;
    gap: 6px;
    max-width: 26rem;
    padding: 20px 22px;
    border: 1px solid var(--line-strong);
    text-decoration: none;
    transition: background-color 0.4s ease, color 0.4s ease, border-color 0.4s;
  }

  .teach__studio:hover { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  .teach__studio-name { font-family: var(--font-display); font-stretch: 87.5%; font-size: var(--fs-h3); }
  .teach__studio-meta { display: inline-flex; align-items: center; gap: 6px; font-size: 0.9rem; color: inherit; opacity: 0.8; }
  .teach__studio-meta :global(svg) { width: 14px; height: 14px; }

  .teach__media { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 16px; align-items: start; }
  .teach__fig--a { grid-column: 1 / span 7; }
  .teach__fig--b { grid-column: 7 / span 6; margin-top: 30%; }
  .teach__frame { aspect-ratio: 4 / 5; }
  .teach__frame :global(img) { width: 100%; height: 100%; object-fit: cover; }

  @media (min-width: 1000px) {
    .teach__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; }
  }
</style>
