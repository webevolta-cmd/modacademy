---
import { Picture, getImage } from 'astro:assets';
import SectionIndex from './SectionIndex.astro';
import SplitText from './SplitText.astro';
import Icon from './Icon.astro';
import { work, student } from '../data/media';

const items = await Promise.all(
  work.map(async (w) => {
    const large = await getImage({ src: w.image, width: 2048, format: 'webp', quality: 86 });
    const medium = await getImage({ src: w.image, width: 1280, format: 'webp', quality: 84 });
    return { ...w, large: large.src, medium: medium.src };
  }),
);

const layout = ['a', 'b', 'c', 'd', 'e', 'f', 'g'];
---
<section class="work section" id="work" aria-labelledby="work-title">
  <div class="wrap">
    <SectionIndex n="05" label="Ուսանողական աշխատանքներ" />
    <div class="work__head">
      <SplitText id="work-title" class="h1" text="Աշխատանքներ, որոնք ստեղծել են ուսանողները" accent="ուսանողները" />
      <aside class="work__card" data-reveal aria-label="Աշխատանքների հեղինակը">
        <p class="label label--red">Ուսանողական աշխատանք</p>
        <p class="work__name">{student.name}</p>
        <p class="muted">{student.role}</p>
        <blockquote class="work__quote">
          <p>«{student.quote}»</p>
          <footer class="muted">— MOD Academy, <time datetime={student.sourceDate}>22.10.2026</time></footer>
        </blockquote>
        <div class="work__links">
          <a class="link-arrow" href={student.instagram} target="_blank" rel="noopener">
            {student.handle}<Icon name="arrow-up-right" />
          </a>
          <a class="link-arrow" href={`/courses/${student.courseSlug}/`}>«{student.course}» դասընթաց<Icon name="arrow" /></a>
        </div>
      </aside>
    </div>

    <ul class="work__grid" role="list">
      {items.map((w, i) => (
        <li class={`work__item work__item--${layout[i]}`} data-reveal="fade" style={`--i:${i % 3}`}>
          <figure>
            <button
              type="button"
              class="work__btn frame"
              data-lb-group="work"
              data-lb-src={w.large}
              data-lb-srcset={`${w.medium} 1280w, ${w.large} 2048w`}
              data-lb-alt={w.alt}
              data-lb-title={w.title}
              data-lb-credit={`${student.name} · ${student.role}`}
              aria-label={`Բացել մեծ չափով՝ ${w.title}`}
            >
              <Picture
                src={w.image}
                alt={w.alt}
                widths={[400, 640, 960, 1280]}
                sizes={i === 0 ? '(min-width: 900px) 56vw, 92vw' : '(min-width: 900px) 32vw, 46vw'}
                formats={['avif', 'webp']}
                loading="lazy"
                data-parallax
                style={`--ps:${i % 2 ? 1.1 : 1.14}`}
              />
              <span class="work__zoom" aria-hidden="true"><Icon name="expand" /></span>
            </button>
            <figcaption class="work__cap">
              <span class="num work__i" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <span class="work__t">{w.title}</span>
              <span class="work__a">{student.name} · «{student.course}»</span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>

    <p class="work__note muted" data-reveal>
      Ներկայացված են «{student.course}» դասընթացի շրջանավարտի 3D վիզուալիզացիաները՝ ակադեմիայի պաշտոնական
      հրապարակումից։ Պատկերների լուծաչափը բարելավված է էկրանների համար՝ առանց կոմպոզիցիայի և դիզայնի փոփոխության։
    </p>
  </div>
</section>

<style>
  .work { background: var(--paper); }

  .work__head { display: grid; gap: 32px; margin-bottom: clamp(40px, 5vw, 80px); }

  .work__card {
    display: grid;
    gap: 8px;
    align-content: start;
    padding: 24px;
    background: var(--card);
    border: 1px solid var(--line);
    max-width: 30rem;
  }

  .work__name { font-family: var(--font-display); font-stretch: 87.5%; font-size: var(--fs-h2); line-height: 1.1; }

  .work__quote { margin: 12px 0 0; padding-left: 14px; border-left: 2px solid var(--red); }
  .work__quote p { font-family: var(--font-display); font-size: 1.1rem; line-height: 1.45; }
  .work__quote footer { font-size: 0.8rem; margin-top: 6px; }

  .work__links { display: flex; flex-wrap: wrap; gap: 10px 24px; margin-top: 12px; font-size: 0.92rem; }

  .work__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px 12px;
  }

  .work__item--a { grid-column: 1 / -1; }

  .work__btn {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1;
    padding: 0;
    border: 0;
    cursor: zoom-in;
  }

  .work__btn :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .work__zoom {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: rgb(244 239 232 / 0.88);
    color: var(--ink);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.4s ease, transform 0.5s var(--ease-out);
  }

  .work__zoom :global(svg) { width: 18px; height: 18px; }

  .work__btn:hover .work__zoom,
  .work__btn:focus-visible .work__zoom { opacity: 1; transform: none; }

  @media (hover: none) {
    .work__zoom { opacity: 1; transform: none; }
  }

  .work__cap {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 12px;
    row-gap: 2px;
    margin-top: 12px;
    font-size: 0.9rem;
  }

  .work__i { grid-row: 1 / span 2; color: var(--red); font-size: 0.85rem; padding-top: 2px; }
  .work__t { font-weight: 560; }
  .work__a { color: var(--muted); font-size: 0.8rem; }

  .work__note { margin-top: clamp(32px, 4vw, 56px); font-size: 0.85rem; max-width: 52rem; }

  @media (min-width: 900px) {
    .work__head { grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr); align-items: start; }
    .work__card { justify-self: end; }

    .work__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: clamp(32px, 4vw, 64px) clamp(16px, 2vw, 32px);
      align-items: start;
    }

    .work__item--a { grid-column: 1 / span 7; }
    .work__item--b { grid-column: 9 / span 4; margin-top: 22%; }
    .work__item--c { grid-column: 2 / span 4; }
    .work__item--d { grid-column: 7 / span 6; margin-top: -8%; }
    .work__item--e { grid-column: 1 / span 4; }
    .work__item--f { grid-column: 5 / span 4; margin-top: 14%; }
    .work__item--g { grid-column: 9 / span 4; }
  }
</style>
